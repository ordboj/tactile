{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tactile",
  // Assets-only SPA. There is no Worker script.
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Persist logs and traces. The top-level flag does not enable traces.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
